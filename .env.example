# Copy this file to .env.local and fill in the Firebase values.
# .env.local is git-ignored; share it with the group privately.

# --- Firebase web app (Firebase console > Project settings > General > Your apps) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (Project settings > Service accounts > Generate new private key) ---
# Copy project_id, client_email and private_key from the downloaded JSON.
# Keep the private key on one line with \n where the line breaks were, inside double quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Services from docker-compose.yml ---
MONGO_URL=mongodb://127.0.0.1:27018
MONGO_DB_NAME=marketplace
ELASTICSEARCH_URL=http://127.0.0.1:9200

PORT=3000
